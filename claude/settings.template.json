{
 "about": "Hook and statusline wiring merged into ~/.claude/settings.json by install/install.py. {PY} becomes the Python command for the OS (python on Windows, python3 on macOS/Linux). Nothing else in settings.json is touched.",
 "statusLine": {"type": "command", "command": "PYTHONIOENCODING=utf-8 {PY} ~/.claude/statusline.py", "padding": 1},
 "hooks": {
  "SessionStart": [
   {"hooks": [{"type": "command", "command": "node ~/.claude/hooks/caveman-activate.js", "timeout": 5}]},
   {"matcher": "compact|resume", "hooks": [{"type": "command", "command": "PYTHONIOENCODING=utf-8 {PY} ~/.claude/hooks/compact_guard.py", "timeout": 10}]},
   {"matcher": "startup|clear|compact", "hooks": [{"type": "command", "command": "PYTHONIOENCODING=utf-8 {PY} ~/.claude/hooks/wtl_boot.py profile", "timeout": 8}]},
   {"matcher": "startup|clear|compact", "hooks": [{"type": "command", "command": "PYTHONIOENCODING=utf-8 {PY} ~/.claude/hooks/wtl_boot.py infra", "timeout": 8}]},
   {"matcher": "startup|clear|compact", "hooks": [{"type": "command", "command": "PYTHONIOENCODING=utf-8 {PY} ~/.claude/hooks/wtl_boot.py project", "timeout": 8}]},
   {"matcher": "startup|clear|compact", "hooks": [{"type": "command", "command": "PYTHONIOENCODING=utf-8 {PY} ~/.claude/hooks/wtl_boot.py threads", "timeout": 8}]},
   {"matcher": "startup|clear|compact", "hooks": [{"type": "command", "command": "PYTHONIOENCODING=utf-8 {PY} ~/.claude/hooks/wtl_boot.py people", "timeout": 8}]}
  ],
  "UserPromptSubmit": [
   {"hooks": [{"type": "command", "command": "node ~/.claude/hooks/caveman-mode-tracker.js", "timeout": 5}]},
   {"hooks": [{"type": "command", "command": "PYTHONIOENCODING=utf-8 {PY} ~/.claude/hooks/quota_advisory.py", "timeout": 5}]},
   {"hooks": [{"type": "command", "command": "PYTHONIOENCODING=utf-8 {PY} ~/.claude/hooks/wtl_nudge.py", "timeout": 5}]}
  ],
  "PreToolUse": [
   {"matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit", "hooks": [{"type": "command", "command": "PYTHONIOENCODING=utf-8 {PY} ~/.claude/hooks/guardrails.py", "timeout": 15}]}
  ],
  "PostToolUse": [
   {"matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit", "hooks": [{"type": "command", "command": "PYTHONIOENCODING=utf-8 {PY} ~/.claude/hooks/audit.py", "timeout": 10}]},
   {"matcher": "Bash", "hooks": [{"type": "command", "command": "PYTHONIOENCODING=utf-8 {PY} ~/.claude/hooks/wtl_contact_nudge.py", "timeout": 10}]}
  ],
  "PostToolUseFailure": [
   {"matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit", "hooks": [{"type": "command", "command": "PYTHONIOENCODING=utf-8 {PY} ~/.claude/hooks/audit.py", "timeout": 10}]}
  ],
  "PreCompact": [
   {"hooks": [{"type": "command", "command": "PYTHONIOENCODING=utf-8 {PY} ~/.claude/hooks/compact_guard.py", "timeout": 30}]}
  ],
  "Stop": [
   {"hooks": [{"type": "command", "command": "PYTHONIOENCODING=utf-8 {PY} ~/.claude/hooks/turn_end.py", "timeout": 60}]}
  ],
  "Notification": [
   {"hooks": [{"type": "command", "command": "PYTHONIOENCODING=utf-8 {PY} ~/.claude/hooks/turn_end.py", "timeout": 10}]}
  ]
 }
}
